# Base de données locale SQLite (utilisée par Prisma)
DATABASE_URL="file:./dev.db"

# Réseau PrusaLink (Menu Réglages -> Réseau -> PrusaLink sur la Prusa MK4)
PRUSA_IP="192.168.0.17"
PRUSA_HOSTNAME="prusa-mk4"
PRUSA_USER="maker"
# Mot de passe / clé PrusaLink affiché sur l'écran de la MK4 (utilisé en X-Api-Key et HTTP Digest)
PRUSA_API_KEY="votre_mot_de_passe_prusalink"

# Mode simulation : "true" hors du Wi-Fi de l'imprimante, "false" pour piloter la vraie Prusa MK4
PRUSA_MOCK="false"
